FROM node:22-bookworm-slim AS build

WORKDIR /workspace/app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
COPY remotion ./remotion
RUN npm run build

FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --uid 10001 --create-home renderer

WORKDIR /workspace/app
COPY --from=build /workspace/app/node_modules ./node_modules
COPY --from=build /workspace/app/dist ./dist
COPY --from=build /workspace/app/remotion ./remotion

ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
USER 10001:10001
ENTRYPOINT ["node", "dist/src/render/container-entry.js"]
