{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jpequegn/video-as-code-agent-editor/schemas/media-manifest.schema.json",
  "title": "MediaManifestV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "manifestId",
    "assetId",
    "source",
    "container",
    "durationSeconds",
    "video",
    "audio",
    "transcript",
    "scenes",
    "provenance"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "manifestId": { "$ref": "#/$defs/sha256" },
    "assetId": { "$ref": "#/$defs/sha256" },
    "source": {
      "type": "object",
      "required": ["algorithm", "digest", "bytes", "objectPath"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 0 },
        "objectPath": { "type": "string", "pattern": "^objects/sha256/[a-f0-9]{2}/[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "container": { "type": "string", "minLength": 1 },
    "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
    "video": { "type": "object" },
    "audio": { "type": ["object", "null"] },
    "transcript": { "type": "array" },
    "scenes": { "type": "array" },
    "provenance": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
