{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jpequegn/video-as-code-agent-editor/schemas/creative-plan.schema.json",
  "title": "CreativePlanV1",
  "type": "object",
  "required": [
    "schemaVersion",
    "planId",
    "mediaManifestId",
    "title",
    "brief",
    "hook",
    "output",
    "segments",
    "captions",
    "highlights",
    "audioMarkers",
    "transitions",
    "constraints",
    "template"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "planId": { "$ref": "#/$defs/sha256" },
    "mediaManifestId": { "$ref": "#/$defs/sha256" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "brief": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "hook": { "type": "string", "minLength": 1, "maxLength": 240 },
    "output": { "type": "object" },
    "segments": { "type": "array", "minItems": 1 },
    "captions": { "type": "array" },
    "highlights": { "type": "array" },
    "audioMarkers": { "type": "array" },
    "transitions": { "type": "array" },
    "constraints": { "type": "object" },
    "template": { "type": "object" }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
